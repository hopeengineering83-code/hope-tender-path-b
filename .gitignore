# PR #256 — local-only benchmark samples used for gap analysis.
# Contains sensitive tender PDFs and generated proposals; never
# commit to git.
benchmark-samples/

# Local dev file storage (storage adapter writes here in non-Vercel environments)
.storage/

# Duplicate project trees — these are full Next.js project copies used
# only for local gap analysis. They must NEVER be committed to git or
# uploaded to Vercel (causes build OOM from ~28K extra TypeScript files
# being pulled into type-checking). They are also excluded in tsconfig.json
# and .eslintignore.
repo/
repo-866/
repo-fix/
repo-pr866/

# Skill scaffolding — ships its own broken imports to z-ai-web-dev-sdk
# which is not part of this app's dependencies. Also excluded in tsconfig.json
# and .eslintignore.
skills/

# User uploads (transient — screenshots, etc.)
# Anchored to repo root so app/api/upload/route.ts is NOT ignored.
/upload/

# Tool-generated persisted outputs (Read tool large outputs)
tool-results/
.auth/

# Local ad-hoc verification scripts and their generated screenshot output —
# never part of the PR diff (see scripts/capture-production-pages.mjs on
# tmp/app-page-screenshot-capture for the CI-uploaded equivalent).
.scratch-*
artifacts/

# CI's own generated diagnostics output (uploaded as workflow artifacts on
# failure, never committed — see .github/workflows/ci.yml's
# "Upload diagnostics on failure" step).
test-results/
build-results/
playwright-report/
test-results-e2e/
# Written by the "Browser smoke…" and "Upload credential-free exact-head
# acceptance evidence" CI steps. browser-results/playwright.log is raw test
# stdout and acceptance-evidence/ holds generated DOCX/PDF/ZIP and screenshots
# — both are uploaded as workflow artifacts, never committed.
browser-results/
acceptance-evidence/
.env*
.ci-env.sh
.start-drive-server.sh
.gemini-key.sh
