{
  "framework": "nextjs",
  "buildCommand": "node scripts/check-env.mjs && prisma generate && prisma migrate deploy && next build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/ai-jobs/run-next",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup-old-records",
      "schedule": "0 3 * * 0"
    }
  ]
}
