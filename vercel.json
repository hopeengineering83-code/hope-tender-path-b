{
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/deadline-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup-tender-storage",
      "schedule": "0 4 * * *"
    }
  ]
}
