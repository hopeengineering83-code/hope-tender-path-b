{
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/deadline-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup-old-records",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/cleanup-tender-storage",
      "schedule": "0 4 * * *"
    }
  ]
}
