{
  "_comment_": "Electron Builder config for Hope Tender desktop app (PR #246). To use: npm install --save-dev electron electron-builder, then npm run build:desktop.",
  "appId": "com.hope.tender.proposal",
  "productName": "Hope Tender Proposal Generator",
  "copyright": "Copyright © 2026 Hope Urban Planning Architectural and Engineering Consultancy",
  "directories": {
    "output": "dist-electron",
    "buildResources": "electron"
  },
  "files": [
    "electron/**/*",
    "public/icon-*.png",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "public/icon-512.png",
      "to": "icon.png"
    }
  ],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "public/icon-512.png",
    "artifactName": "Hope-Tender-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hope Tender"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["universal"] }
    ],
    "icon": "public/icon-512.png",
    "category": "public.app-category.business",
    "artifactName": "Hope-Tender-${version}-${arch}.${ext}"
  },
  "dmg": {
    "title": "Hope Tender ${version}",
    "icon": "public/icon-512.png"
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] }
    ],
    "icon": "public/icon-512.png",
    "category": "Office",
    "artifactName": "hope-tender-${version}-${arch}.${ext}"
  },
  "publish": null,
  "asar": true,
  "compression": "maximum"
}
