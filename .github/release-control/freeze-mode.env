# Freeze Mode Configuration
#
# When FREEZE_MODE=true:
#   - All PRs targeting main are rejected (except authorized control-plane promotions)
#   - Direct pushes to main are blocked
#   - Production deployment commands are blocked
#   - Production migrations are blocked
#   - Auto-merge and auto-approval are blocked
#   - All worker PRs must target integration/controlled-recovery
#   - All infrastructure PRs must target automation/control-plane
#
# This file is read by:
#   - .github/workflows/freeze-guard.yml (enforces freeze on PR/push events)
#   - .github/workflows/release-gate.yml (checks freeze state before any release)
#   - .github/workflows/autonomous-repair-coordinator.yml (respects freeze)
#
# To lift the freeze: set FREEZE_MODE=false and merge via an authorized
# control-plane promotion PR.

FREEZE_MODE=true

# Authorized control-plane promotion: the ONLY way to merge to main during freeze.
# The promotion PR must:
#   1. Target main from automation/control-plane
#   2. Be labeled "control-plane-promotion"
#   3. Have passed the full release-gate suite on the exact head SHA
#   4. Have explicit human approval from the release manager
AUTHORIZED_PROMOTION_LABEL=control-plane-promotion

# Worker repair PRs must target this branch during freeze.
WORKER_TARGET_BRANCH=integration/controlled-recovery

# Infrastructure PRs must target this branch during freeze.
INFRA_TARGET_BRANCH=automation/control-plane

# Maximum concurrent active workers (non-overlapping file ownership).
MAX_CONCURRENT_WORKERS=3

# Maximum repair attempts per finding before BLOCKED status.
MAX_REPAIR_ATTEMPTS=3

# Stale lock threshold (minutes) — locks older than this are auto-released.
LOCK_STALE_MINUTES=30
