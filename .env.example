# ── Database (PostgreSQL required — SQLite not supported in production) ────────
# Use Neon, Supabase, Railway, or any PostgreSQL provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Session security ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-this-with-a-64-character-random-hex-string"

# ── AI provider chain ───────────────────────────────────────────────────────
# Default order: OpenAI → Gemini → Mistral → DeepSeek → Groq → Together →
# OpenRouter → Claude/Anthropic. Analysis/extraction: Gemini → OpenAI →
# Mistral → Together → DeepSeek → Groq → OpenRouter → Claude.
# Claude/Anthropic is intentionally last so Anthropic rate limits do not block
# the app when earlier providers are configured. Set at least one provider key.
# OPENAI_API_KEY="sk-..."
# OPENAI_PROPOSAL_MODEL="gpt-4o"
# MISTRAL_API_KEY="..."
# MISTRAL_PROPOSAL_MODEL="mistral-large-latest"
# MISTRAL_ANALYSIS_MODEL="mistral-large-latest"
# MISTRAL_FAST_MODEL="ministral-8b-latest"
# DEEPSEEK_API_KEY="..."
# DEEPSEEK_PROPOSAL_MODEL="deepseek-chat"
# GROQ_API_KEY="gsk_..."
# GROQ_PROPOSAL_MODEL="llama-3.3-70b-versatile"
# TOGETHER_API_KEY="..."
# TOGETHER_PROPOSAL_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"
# TOGETHER_ANALYSIS_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"
# TOGETHER_FAST_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo"
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_PROPOSAL_MODEL="openrouter/auto"
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the Claude model chain (last-resort order, comma-separated).
# The first Claude model that succeeds is used. Default chain (in lib/ai.ts):
# claude-sonnet-4-5,claude-opus-4-1,claude-3-5-sonnet-latest,claude-3-5-haiku-latest
# Pin specific snapshot models if you need date-stable output:
# ANTHROPIC_PROPOSAL_MODELS="claude-sonnet-4-5-20250929,claude-3-5-sonnet-20241022"

# Optional: max output tokens per Claude call.
# Default (in lib/ai.ts) is 8000 — chosen for compatibility with Vercel
# Hobby plan (60s function timeout). 8K tokens ≈ 25–40s Claude response
# time; 16K ≈ 60–120s. The Hobby 60s window cannot accommodate 16K
# output reliably.
#
# Tier-specific guidance:
#   - Vercel Hobby (60s timeout)   + Anthropic Tier 1+:   8000 (default)
#   - Vercel Pro (300s timeout)    + Anthropic Tier 2+:   16000
#   - Vercel Enterprise (900s+)    + Anthropic Tier 3+:   up to 32000
# Hard cap: 64000 (enforced in code).
# ANTHROPIC_MAX_OUTPUT_TOKENS="8000"

# Optional: in-route timeout for the AI tender-analysis call.
# Layered INSIDE the Vercel maxDuration (60s on Hobby, 300s on Pro)
# so the route can fail gracefully and return a deterministic fallback
# before Vercel kills the whole function.
#
# Tier-aware defaults (when AI_ANALYSIS_TIMEOUT_MS is unset):
#   Tier 1 (Vercel Hobby):       50_000  (50s, 10s buffer under 60s cap)
#   Tier 2+ (Vercel Pro, default): 180_000 (3 min, 120s buffer under 300s cap)
#   Tier 3+ (Enterprise):        240_000  (4 min)
#
# Set ANTHROPIC_TIER=1 / 2 / 3 to control the tier-aware default.
# Range: 5000 (5s) to 600000 (10 min). Values outside the range fall
# back to the tier-aware default.
# AI_ANALYSIS_TIMEOUT_MS="180000"

# Optional: per-file character cap fed into AI tender analysis.
# Pre-PR #396 default was 3,500 chars/file (~25% of a typical 14KB
# tender PDF), causing the AI to see only the first page and miss
# the evaluation criteria + scoring matrix + submission rules that
# usually live mid-document. New default 12,000 chars/file.
#
# Multi-file tenders: the sum stays under the chunked-analysis
# trigger (60K) until ~5 files of 12K each, at which point
# lib/ai.ts's chunked path takes over.
#
# Range: 1000 - 50000. Values outside the range fall back to 12_000.
# TENDER_AI_MAX_FILE_CHARS="12000"

# Optional: proposal generation mode — "parallel" (default) or "single".
# The "parallel" path runs FOUR concurrent Claude calls (Cover+Exec
# Summary, Section A+B, Section C, Section D+Appendices+Declaration)
# and stitches the results. Each call has its own per-section system
# prompt (see lib/engine/proposal-sections.ts) and only sees the
# evidence it needs. Wall time on Vercel Hobby ≈ 25–30s vs 45–55s for
# the legacy single-call path, with comparable or better quality
# because Claude has more "thinking room" per section.
#
# The "single" path is the legacy monolithic call — Claude writes the
# entire ~8K-token proposal in one shot. Useful for A/B comparison,
# and viable on Vercel Pro (300s budget).
#
# Recommendation:
#   - Vercel Hobby:        leave unset (parallel default)
#   - Vercel Pro:          either mode works; parallel still recommended
# PROPOSAL_GENERATION_MODE="parallel"

# Optional: per-section timeout for the parallel generation path.
# Each section's Claude call is wrapped in this timeout independently;
# if one section runs long, the other three still ship and the slow
# section falls back to a deterministic skeleton. Default 30_000 (30s)
# is tuned for Anthropic Tier 2+. Range: 5000–600000.
# PROPOSAL_SECTION_TIMEOUT_MS="30000"

# Optional: FULL POWER deep-mode generation.
# When set to "true", two changes activate together:
#   1. Each per-section max_output_tokens roughly doubles. The four
#      parallel section calls now use the full Anthropic Tier 2+
#      output budget (~16K tokens / min) instead of ~8K.
#   2. A CHAINED second Claude call drills down on Section C
#      (Technical Approach) to deepen each methodology sub-section —
#      adding 2–3 paragraphs per scope item, naming experts inline,
#      citing previous projects when the methodology element was
#      demonstrated there. The drilled-down Section C replaces the
#      first-pass version.
#
# Net result: ~16–20K tokens of Claude prose per proposal vs ~8K in
# standard mode — much closer to Claude.ai-level depth on big tenders.
#
# Tier-specific guidance:
#   - Vercel Hobby (60s)  + Anthropic Tier 1:    leave OFF
#   - Vercel Hobby (60s)  + Anthropic Tier 2+:   try with care
#   - Vercel Pro (300s)   + Anthropic Tier 2+:   recommended ON
#   - Vercel Pro (300s)   + Anthropic Tier 3+:   recommended ON
# PROPOSAL_DEEP_MODE="true"

# Optional: TENDER DEEP REASONING — Claude-style two-stage thinking.
# When set to "true" (or "1"/"yes"/"on"), two additional Claude-powered
# passes activate that bring proposal generation closer to interactive
# Claude.ai quality:
#
#   1. SEMANTIC TENDER COMPREHENSION. Before the AI prompt is built,
#      a structured Claude call reads the tender text and emits JSON
#      describing the evaluation criteria (with numeric weights when
#      stated), disqualifying clauses, and structural prohibitions
#      ("no joint ventures", "lead firm must have ≥5 years incorp.").
#      That structure is injected into the proposal-generation prompt
#      so Claude reads weights and disqualifiers BEFORE writing.
#      Replaces what the regex analyser cannot decode — it does not
#      replace the regex analyser itself, which still runs as the
#      baseline. See lib/engine/evaluation-criteria-extractor.ts.
#
#   2. CRITIC-REWRITER REFINEMENT. The legacy single-pass refinement
#      ("here are weak axes, fix them in one shot") is replaced by a
#      two-step cognitive loop per iteration:
#        a) CRITIQUE pass — Claude reads the draft + weak axes +
#           extracted criteria and writes a structured critique
#           naming specific defects with locations, evidence cites,
#           and proposed fixes.
#        b) REWRITE pass — a second Claude call takes the critique
#           and the draft and applies every fix, returning the
#           revised markdown.
#      Iterations carry a failure-mode memory (which axes were fixed
#      last time, which weren't) so the next critique avoids
#      repeating instructions that didn't move the score.
#      See lib/engine/deep-reasoning-refiner.ts.
#
# Cost: two extra Claude calls per refinement iteration (vs one in the
# legacy path). On Vercel Hobby this risks blowing the 60s function
# budget if QUALITY_REFINEMENT_THRESHOLD is not also lowered. The
# safest combinations are:
#   - Vercel Pro + Anthropic Tier 2+:  TENDER_DEEP_REASONING="true"
#   - Vercel Hobby:                    leave OFF
#
# Default OFF — both legacy paths (regex analyser + single-pass
# refiner) continue to work unchanged when this is unset.
# TENDER_DEEP_REASONING="true"

# Optional: TOOL-USE DURING GENERATION. Requires TENDER_DEEP_REASONING=true
# and PROPOSAL_GENERATION_MODE=single. When set, Claude is given
# access to evidence-search tools (search_company_knowledge,
# inspect_expert, inspect_project) WHILE writing the proposal — not
# just during critique. The model can verify a project exists in the
# vault before naming it, look up an expert's exact certifications
# before asserting them, and search for the strongest project for a
# given criterion before anchoring the methodology to it.
#
# Cost: 1–6 extra mid-write Claude turns per generation (capped at
# MAX_TOOL_TURNS=6 in lib/ai.ts).
#
# Recommended only on Vercel Pro + Anthropic Tier 2+ with the
# single-call generation mode. The parallel section path is NOT
# wired for tools yet (each section call would need its own tool
# loop, which is out of scope for this PR).
#
# Default OFF.
# TENDER_TOOL_USE_GENERATION="true"

# Optional: TENDER_DEEP_REASONING_MAX_CALLS=N caps per-tender Claude
# calls in the deep-reasoning path. When set, the telemetry collector
# throws DeepReasoningBudgetExceededError on the (N+1)-th call without
# invoking the wrapped function. Useful as a hard ceiling for tight
# budgets. Default OFF (no cap).
# TENDER_DEEP_REASONING_MAX_CALLS="6"

# Optional: PDF OCR fallback for scanned-image PDFs.
# When the three text-layer extractors (pdf-parse, pdf2json, pdfjs)
# all return < 20 chars, the PDF has no text layer — it's a scanned
# image. The fix: pass the PDF buffer directly to Claude as a
# `document` content block. Claude's vision-equivalent PDF support
# reads scanned PDFs natively without Tesseract or any external OCR
# API. Output goes through the same normalization as text-layer
# extraction.
#
# Cost: Anthropic charges per page on PDF document blocks. A 50-page
# scanned PDF takes ~10-30s and uses model output tokens proportional
# to extracted text. Default OFF to avoid surprise charges.
#
# Recommendation:
#   - All tenders are digital PDFs:  leave OFF (current behaviour)
#   - Some tenders are scanned PDFs: set true, requires ANTHROPIC_API_KEY
# PDF_OCR_ENABLED="true"

# Optional: model used for OCR (defaults to claude-3-5-sonnet-latest).
# Sonnet handles scanned PDFs reliably; Haiku is cheaper but less
# accurate on poor-quality scans.
# PDF_OCR_MODEL="claude-3-5-sonnet-latest"

# Optional: maximum pages per OCR call (default 50, max 100).
# Anthropic accepts up to 100 pages per request; lower this if you
# want to bound cost on big scanned PDFs.
# PDF_OCR_MAX_PAGES="50"

# Optional: OCR race/concurrency guard. Recommended production value: 1
# on Vercel to avoid unnecessary provider races and transfer/cost spikes.
# PDF_OCR_MAX_RACES="1"

# (Implicitly used by chunked analysis — no env-var, automatic.)
# When the uploaded tender content exceeds 60K chars, analyzeWithAI
# automatically splits it into overlapping 50K chunks and analyzes
# each chunk in PARALLEL via Claude, then merges the results
# (requirement union, longest summary, concatenated evaluation
# methodology, concatenated submission notes). This means big RFPs
# (200-page PDFs with 250K+ chars) are now fully analyzed instead of
# silently truncated. No configuration needed.

# Optional: disable the post-generation refinement pass.
# When the deterministic quality scorer flags a generated proposal as
# falling below the 70/100 threshold, the engine triggers a second
# Claude call to rewrite the weak axes in place. This adds 30–60s to
# the request — on Vercel Hobby (60s function timeout) this reliably
# pushes the total request time over the budget.
#
# Set to "true" to disable refinement entirely. The deterministic
# backstops (Compliance Matrix, Evaluator Mirror, Win Themes,
# Self-Score) and the in-prompt Section E-H instructions still
# guarantee the four mandatory tables, so disabling has minimal
# quality impact on properly-tuned tenders.
#
# Recommendation:
#   - Vercel Hobby:           PROPOSAL_REFINEMENT_DISABLED=true
#   - Vercel Pro (300s):      leave unset (refinement enabled)
# PROPOSAL_REFINEMENT_DISABLED="true"

# Gemini is the primary analysis/extraction provider and second provider in
# the default proposal chain. Get from: https://aistudio.google.com/app/apikey
# Key format: AIza followed by 35 alphanumeric characters (39 chars total)
# Do NOT put an Anthropic (sk-ant-...) or OpenAI (sk-...) key here.
GEMINI_API_KEY="AIza..."

# Optional: override the default Gemini model (default: gemini-2.5-pro)
# Useful to pin a stable model or reduce cost in development.
# GEMINI_MODEL="gemini-2.0-flash"
# GEMINI_ANALYSIS_MODEL="gemini-2.5-pro"
# GEMINI_EXTRACTION_MODEL="gemini-2.0-flash"
# GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-2.0-flash"


# ── Observability (PR #254) ───────────────────────────────────────────────────
# Optional: minimum log level. Lines below this level are dropped from
# stdout. Default is "info"; set "debug" to enable detailed tracing,
# or "warn"/"error" to suppress informational logs in production.
# Valid values: debug | info | warn | error
# LOG_LEVEL="info"

# Optional: Sentry DSN for error reporting. When set, every error
# routed through reportError() in lib/observability.ts is sent to
# Sentry's HTTP envelope endpoint. The implementation does NOT use
# the Sentry SDK — it makes a direct HTTP POST so the bundle stays
# small and Vercel cold-starts stay fast.
#
# Format: https://PUBLIC_KEY@HOST/PROJECT_ID
# Get from: https://sentry.io/settings/[org]/projects/[project]/keys/
# When unset, errors are still logged to stdout — just not aggregated
# in the Sentry dashboard.
# SENTRY_DSN="https://abc123@o123456.ingest.sentry.io/789"

# ── Optional ──────────────────────────────────────────────────────────────────
# STORAGE_ROOT="./.storage"
# BLOB_READ_WRITE_TOKEN=""

# ── Bootstrap admin (DO NOT enable in production unless you must) ─────────────
# In production the runtime seed + login route never repair / create
# admin@hope.local unless BOTH of these are set. The password must be
# 16+ chars and not on the banned-defaults list (Admin123!, changeme,
# password, secret).
# BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_PASSWORD="generate-a-unique-high-entropy-secret"

# ── Runtime DB schema bootstrap (production: keep OFF) ────────────────────────
# In production this defaults to OFF so request handlers never run
# CREATE TABLE / ALTER TABLE / CREATE INDEX. Schema is owned by your
# migration toolchain (prisma migrate deploy). Set to true only for
# initial onboarding before migrations are wired up.
# ENABLE_RUNTIME_SCHEMA_BOOTSTRAP=false

# ── Preview env-check strictness ──────────────────────────────────────────────
# When set, Vercel preview deployments are validated with production-grade
# strictness for required env vars (DATABASE_URL, SESSION_SECRET, at
# least one AI key). Otherwise previews allow soft warnings.
# STRICT_PREVIEW_ENV_CHECK=false

# ── Email notifications (optional) ───────────────────────────────────────────
# If not set, emails are logged only — the app never crashes on missing config.
# To enable deadline alert emails, set all SMTP_* vars and wire the cron route
# in vercel.json: { "crons": [{ "path": "/api/cron/deadline-alerts", "schedule": "0 8 * * *" }] }
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=noreply@yourapp.com
# NEXT_PUBLIC_APP_URL=https://yourapp.vercel.app
