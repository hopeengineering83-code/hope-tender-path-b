generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String?
  email        String      @unique
  passwordHash String
  role         String      @default("PROPOSAL_MANAGER")
  company      Company?
  sessions     Session[]
  tenders      Tender[]
  auditLogs    AuditLog[]
  // PR #247 — DocumentReview / DocumentComment back-relations
  documentReviews  DocumentReview[]
  documentComments DocumentComment[]
  notifications    Notification[]
  tenderShares TenderShare[]
  metadataOverrides    TenderMetadataOverride[]
  passwordResetTokens  PasswordResetToken[]
  submissionPlansCreated    SubmissionPlanRevision[]      @relation("SubmissionPlanCreatedBy")
  submissionPlansConfirmed  SubmissionPlanRevision[]      @relation("SubmissionPlanConfirmedBy")
  evidenceDecisionsReviewed RequirementEvidenceDecision[] @relation("RequirementEvidenceReviewer")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit DB-002 (2026-06-20): session revocation on password reset /
  // logout-all filters by userId. Was a sequential scan before this index.
  @@index([userId])
}

model Company {
  id                String                    @id @default(uuid())
  name              String
  legalName         String?
  description       String?
  website           String?
  address           String?
  phone             String?
  email             String?
  country           String?
  serviceLines      String                    @default("[]")
  sectors           String                    @default("[]")
  profileSummary    String?
  knowledgeMode     String                    @default("PROFILE_FIRST")
  setupCompletedAt  DateTime?
  // Authorising representative (used in D.4 Declaration of Eligibility,
  // Cover Page Submitted-by/to block, and A.1 Company Background)
  gmName            String?
  gmTitle           String?
  gmLicense         String?
  // Institutional metadata (used in A.0 Portfolio at a Glance, A.1 Company
  // Background, A.7 In-House Capabilities)
  foundingYear      Int?
  headcount         Int?
  licenseGrade      String?
  registrationNumber String?
  tin               String?
  vat               String?
  userId            String                    @unique
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  experts           Expert[]
  projects          Project[]
  documents         CompanyDocument[]
  assets            CompanyAsset[]
  legalRecords      LegalRecord[]
  financialRecords  FinancialRecord[]
  complianceRecords CompanyComplianceRecord[]
  planBStaging      PlanBStaging[]
  settings          AppSettings?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model AppSettings {
  id                     String   @id @default(uuid())
  companyId              String   @unique
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultCurrency        String   @default("USD")
  aiStrictMode           Boolean  @default(true)
  allowBrandingDefault   Boolean  @default(true)
  allowSignatureDefault  Boolean  @default(true)
  allowStampDefault      Boolean  @default(true)
  exportFormat           String   @default("DOCX")
  pageNumbering          Boolean  @default(true)
  includeTableOfContents Boolean  @default(false)
  language               String   @default("en")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model CompanyDocument {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  storagePath      String    @default("")
  fileContent      String?
  // Persisted byte-integrity state. Legacy rows remain UNKNOWN and fail closed.
  contentSha256       String?
  contentByteLength   Int?
  contentMimeType     String?
  detectedFormat      String?
  integrityStatus     String    @default("UNKNOWN")
  integrityVerifiedAt DateTime?
  integrityFailureCode String?
  category         String    @default("OTHER")
  extractedText    String?
  // AI extraction state: PENDING | EXTRACTING | EXTRACTED | FAILED
  aiExtractionStatus String  @default("PENDING")
  aiExtractedAt    DateTime?
  aiExtractionError String?
  metadata         String    @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  expertsSourced  Expert[]
  projectsSourced Project[]
  legalRecordsSourced      LegalRecord[]
  financialRecordsSourced  FinancialRecord[]
  complianceRecordsSourced CompanyComplianceRecord[]

  @@index([companyId])
  @@index([integrityStatus])
}

model CompanyAsset {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetType        String
  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  storagePath      String   @default("")
  fileContent      String?
  // Persisted byte-integrity state. Legacy rows remain UNKNOWN and fail closed.
  contentSha256       String?
  contentByteLength   Int?
  contentMimeType     String?
  detectedFormat      String?
  integrityStatus     String    @default("UNKNOWN")
  integrityVerifiedAt DateTime?
  integrityFailureCode String?
  isActive         Boolean  @default(true)
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
  @@index([integrityStatus])
}

// trustLevel values: REGEX_DRAFT | AI_DRAFT | REVIEWED
// Records start as REGEX_DRAFT (pattern-extracted) or AI_DRAFT (Claude-extracted).
// Only REVIEWED records are treated as authoritative in proposal generation.
model Expert {
  id               String           @id @default(uuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName         String
  title            String?
  email            String?
  phone            String?
  yearsExperience  Int?
  disciplines      String           @default("[]")
  sectors          String           @default("[]")
  certifications   String           @default("[]")
  profile          String?
  isActive         Boolean          @default(true)
  // Trust level — must be REVIEWED before use in final generation
  trustLevel       String           @default("REGEX_DRAFT")
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  // Source document that produced this record
  sourceDocumentId String?
  sourceDocument   CompanyDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenderMatches    TenderExpertMatch[]

  @@index([companyId])
  @@index([trustLevel])
  @@index([deletedAt])
}

// trustLevel values: REGEX_DRAFT | AI_DRAFT | REVIEWED
model Project {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  clientName    String?
  country       String?
  sector        String?
  serviceAreas  String           @default("[]")
  summary       String?
  contractValue Float?
  currency      String?
  startDate     DateTime?
  endDate       DateTime?
  // Trust level — must be REVIEWED before use in final generation
  trustLevel    String           @default("REGEX_DRAFT")
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  // Source document that produced this record
  sourceDocumentId String?
  sourceDocument   CompanyDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  evidences     ProjectEvidence[]
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenderMatches TenderProjectMatch[]

  @@index([companyId])
  @@index([trustLevel])
  @@index([deletedAt])
}

model ProjectEvidence {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  evidenceType     String
  description      String?
  fileName         String?
  storagePath      String?
  extractedText    String?
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectId])
}

// trustLevel values: MANUAL_DRAFT | REGEX_DRAFT | AI_DRAFT | SOURCE_VERIFIED | REVIEWED
// (see lib/vault-review-provenance.ts)
model LegalRecord {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recordType      String
  title           String
  authority       String?
  referenceNumber String?
  issueDate       DateTime?
  expiryDate      DateTime?
  status          String    @default("ACTIVE")
  metadata        String    @default("{}")
  // Trust level — must be REVIEWED (with durable source provenance) before use in final generation
  trustLevel       String           @default("AI_DRAFT")
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  sourceDocumentId String?
  sourceDocument   CompanyDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([trustLevel])
}

model FinancialRecord {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear Int
  recordType String
  currency   String?  @default("USD")
  amount     Float?
  notes      String?
  metadata   String   @default("{}")
  // MANUAL_DRAFT/AI_DRAFT may not be used; REVIEWED requires durable source provenance.
  trustLevel       String           @default("AI_DRAFT")
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  sourceDocumentId String?
  sourceDocument   CompanyDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([trustLevel])
}

model CompanyComplianceRecord {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  complianceType  String
  title           String
  status          String    @default("ACTIVE")
  evidenceSummary String?
  referenceNumber String?
  expiryDate      DateTime?
  metadata        String    @default("{}")
  // MANUAL_DRAFT/AI_DRAFT may not be used; REVIEWED requires durable source provenance.
  trustLevel       String           @default("AI_DRAFT")
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  sourceDocumentId String?
  sourceDocument   CompanyDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([trustLevel])
}

model Tender {
  id                    String               @id @default(uuid())
  title                 String
  description           String?
  reference             String?
  clientName            String?
  category              String               @default("General")
  country               String?
  budget                Float?
  currency              String?
  deadline              DateTime?
  submissionMethod      String?
  submissionAddress     String?
  status                String               @default("DRAFT")
  stage                 String               @default("TENDER_INTAKE")
  intakeSummary         String?
  analysisSummary       String?
  evaluationMethodology String?
  pageLimit             Int?
  exactFileOrder        String               @default("[]")
  exactFileNaming       String               @default("[]")
  readinessScore        Float                @default(0)
  notes                 String?
  bidOutcome            String?
  bidOutcomeNote        String?
  bidOutcomeAt          DateTime?
  // ─── PR XX-METADATA — rich tender detail extracted from PDF body ────────
  // Populated by inferTenderMetadata() on upload-first. Empty when manual
  // intake is used or when the extractor couldn't find the pattern.
  clientContactName     String?
  clientContactTitle    String?
  clientContactEmail    String?
  clientContactPhone    String?
  clientAddress         String?
  // Pipe-joined list ("a@x.com|b@x.com") of every email found in the
  // submission section. Kept portable as string for SQLite/Postgres parity.
  submissionEmails      String?
  validityDays          Int?
  bidBondAmount         Float?
  bidBondCurrency       String?
  preBidMeetingDate     DateTime?
  preBidMeetingLocation String?
  mandatorySiteVisit    Boolean              @default(false)
  numberOfCopiesRequired Int?
  technicalWeight       Int?
  financialWeight       Int?
  // ─── Extended client/procuring-entity extraction ────────────────────────
  // Populated by AI Analyze when the tender contains multiple entity names.
  // procuringEntityName: the official procuring entity / contracting authority.
  // legalClientName: full legal name if different from the display clientName.
  // donorAgency: any donor/funding agency (World Bank, UNDP, KfW, etc.).
  // implementingAgency: project owner / implementing agency when different
  //   from the procuring entity.
  // metadataContaminated: true when detectMetadataContamination() found portal
  //   nav-text, status banners, or related-alert noise inside clientName.
  //   Blocks final export until the field is corrected.
  // clientNameSourcePage / clientNameSourceQuote: page-level audit trail for
  //   the extracted client name so reviewers can verify the source.
  // submissionEmailSourcePage: page where the submission email was found.
  // analysisExtractionStatus: FULL_EXTRACTION_AI_ANALYZED | PARTIAL_EXTRACTION_AI_ANALYZED |
  //   OCR_REQUIRED | EXTRACTION_WEAK_REVIEW_REQUIRED | REGEX_FALLBACK_FROM_WEAK_EXTRACTION
  procuringEntityName      String?
  legalClientName          String?
  donorAgency              String?
  implementingAgency       String?
  metadataContaminated     Boolean              @default(false)
  clientNameSourcePage     Int?
  clientNameSourceQuote    String?
  submissionEmailSourcePage Int?
  // Title source evidence (Blocker 2 — policy-critical but missing durable storage)
  titleSourceFileId       String?
  titleSourcePage          Int?
  titleSourceQuote         String?
  // Deadline source evidence (Blocker 2 — value was hashed but evidence was not)
  deadlineSourceFileId     String?
  deadlineSourcePage       Int?
  deadlineSourceQuote      String?
  // Email endpoint source quote (Blocker 2 — sourceFileId/Page existed but quote was missing)
  submissionEmailSourceQuote String?
  // JSON map of per-field source provenance for contact/location fields extracted
  // by AI Analyze. Shape: { [fieldName]: { page: number|null, quote: string|null, fileId?: string|null } }
  // fileId is added by the repair-metadata route (AI Analyze does not emit it)
  // so contact-sourced fields (e.g. procurementReferenceNumber for reference)
  // can achieve GROUNDED status when fileId points to an active TenderFile.
  // Covers: clientContactName, clientContactTitle, clientContactEmail,
  //         clientContactPhone, clientAddress, submissionAddress, country,
  //         procurementReferenceNumber (for the reference field).
  contactDetailsSourceJson      String?
  // Source traceability for submission method and submission address
  submissionMethodSourcePage    Int?
  submissionMethodSourceQuote   String?
  submissionMethodSourceFileId  String?
  submissionAddressSourcePage   Int?
  submissionAddressSourceQuote  String?
  submissionAddressSourceFileId String?
  // Source file IDs for other metadata fields
  clientNameSourceFileId        String?
  submissionEmailSourceFileId   String?
  // Reference number source evidence (policy-critical field)
  referenceSourceFileId         String?
  referenceSourcePage           Int?
  referenceSourceQuote          String?
  // Submission email subject source evidence (policy-critical field)
  submissionEmailSubjectSourceFileId String?
  submissionEmailSubjectSourcePage   Int?
  submissionEmailSubjectSourceQuote  String?
  // Per-criterion source traceability for evaluation criteria
  // JSON array: [{ criterion, weight, sourcePage, sourceQuote }]
  evaluationCriteriaSourceJson  String?
  analysisExtractionStatus      String?
  // ─── Extended client fields (Gap A — CLAUDE.md items 8–20) ─────────────────
  // Populated by AI Analyze to cover all procuring-entity contact details
  // required by CLAUDE.md.  All nullable so legacy rows are unaffected.
  clientCity            String?
  clientWebsite         String?
  submissionEmailSubject String?
  preBidChannel         String?
  clientRepresentative  String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  files                 TenderFile[]
  requirements          TenderRequirement[]
  expertMatches         TenderExpertMatch[]
  projectMatches        TenderProjectMatch[]
  complianceGaps        ComplianceGap[]
  complianceMatrix      ComplianceMatrix[]
  generatedDocuments    GeneratedDocument[]
  exportPackages        ExportPackage[]
  evaluatorObjections   EvaluatorObjection[]
  matchScoreBreakdowns  MatchScoreBreakdown[]
  aiJobs                AiJob[]
  sectionEvidenceMaps   SectionEvidenceMap[]
  proposalVersions      ProposalVersion[]
  pricingWorkbook       PricingWorkbook?
  shares                TenderShare[]
  copilotMessages       TenderCopilotMessage[]
  metadataOverrides     TenderMetadataOverride[]
  submissionPlanState     SubmissionPlanState?
  submissionPlanRevisions SubmissionPlanRevision[]
  aiUsageRecords          AiUsageRecord[]
  buildPlan               BuildPlan?
  // Universal tender facts ledger (additive — new in feat/universal-tender-facts-ledger)
  factsLedger           TenderFactsLedger[]
  submissionEmailRecords TenderSubmissionEmail[]

  // Audit DB-002 (2026-06-20): the single most-queried column in the app
  // (every "list my tenders" dashboard query filters on userId). Was a
  // sequential scan before this index.
  @@index([userId])
}

model TenderShare {
  id          String   @id @default(cuid())
  tenderId    String
  token       String   @unique @default(cuid())
  label       String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  maxDownloads Int?
  downloadCount Int      @default(0)
  createdById String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])
  @@index([tenderId])
  @@index([token])
}

model TenderFile {
  id               String   @id @default(uuid())
  tenderId         String
  tender           Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  storagePath      String   @default("")
  fileContent      String?
  // File byte integrity — SHA-256 digest for source-file verification.
  // Final ZIP download verifies source files haven't been tampered with
  // since extraction/grounding.
  sha256           String?
  byteSize         Int?
  classification   String?
  extractedText    String?
  // ─── Extraction quality metrics (gap analysis) ───────────────────────────
  totalPages       Int?
  extractedPages   Int?
  ocrPages         Int?
  failedPages      Int?
  extractionScore  Float?   // 0-100
  extractionMethod String?  // "text" | "ocr" | "mixed" | "failed"
  deletionStatus   String   @default("ACTIVE") // ACTIVE | PENDING_DELETE | DELETED
  deletionAttempts Int      @default(0)
  lastDeletionError String?
  deletedAt        DateTime?
  // Per-page status snapshot as JSON array (populated by AI Analyze).
  // Shape: [{ page, charCount, status, hasSubmissionInstructions, ... }]
  pageStatusJson   String?
  ocrModel         String?  // OCR model used if OCR was run, e.g. "claude-3-5-sonnet"
  contentHash      String?  // Legacy MD5 dedup hash; never used as a trust digest
  // Persisted byte-integrity state. Legacy rows remain UNKNOWN and fail closed.
  contentSha256       String?
  contentByteLength   Int?
  contentMimeType     String?
  detectedFormat      String?
  integrityStatus     String    @default("UNKNOWN")
  integrityVerifiedAt DateTime?
  integrityFailureCode String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  requirementEvidenceDecisions RequirementEvidenceDecision[]

  @@index([tenderId])
  @@index([tenderId, deletionStatus]) // Compound — 20+ queries filter by both
  // Partial unique index on (tenderId, contentHash) is migration-managed so
  // empty/NULL legacy hashes remain compatible; Prisma cannot express its WHERE clause.
  @@index([integrityStatus])
}

model TenderRequirement {
  id                   String             @id @default(uuid())
  tenderId             String
  tender               Tender             @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  code                 String?
  title                String
  description          String
  requirementType      String
  priority             String
  sectionReference     String?
  requiredQuantity     Int?
  pageLimit            Int?
  exactFileName        String?
  exactOrder           Int?
  restrictions         String?
  isResolved           Boolean            @default(false)
  // ─── Page-level source coordinates (G9 fix) ──────────────────────────
  // PR XX-G — adds audit-grade source references so each requirement
  // can be cited back to the exact tender file, page, section heading,
  // and verbatim quote. The Copilot, evaluator, and compliance matrix
  // all read from these fields when surfacing "where in the tender does
  // this come from?" answers.
  sourceTenderFileId     String?
  sourcePageNumber       Int?
  sourceSectionHeading   String?
  sourceExactQuote       String?
  sourceExtractionMethod String?  // "text" | "ocr" | "manual"
  sourceConfidence       Float              @default(0)
  complianceMatrixRows ComplianceMatrix[]
  evidenceDecisions    RequirementEvidenceDecision[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tenderId])
  @@index([tenderId, priority]) // Compound — snapshot/gate filter by MANDATORY
  @@index([sourceTenderFileId])
}

model ComplianceMatrix {
  id                String             @id @default(uuid())
  tenderId          String
  tender            Tender             @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  requirementId     String?
  requirement       TenderRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  evidenceType      String
  evidenceSource    String
  evidenceReference String?
  supportLevel      String             @default("PARTIAL")
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([requirementId])
  // Audit DB-002 (2026-06-20): every tender-detail compliance panel loads by tenderId.
  @@index([tenderId])
}

model TenderExpertMatch {
  id         String   @id @default(uuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  expertId   String
  expert     Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  score      Float
  rationale  String?
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenderId, expertId])
  @@index([tenderId])
}

model TenderProjectMatch {
  id         String   @id @default(uuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  score      Float
  rationale  String?
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenderId, projectId])
  @@index([tenderId])
}

model ComplianceGap {
  id             String   @id @default(uuid())
  tenderId       String
  tender         Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  requirementId  String?
  severity       String
  title          String
  description    String
  mitigationPlan String?
  isResolved     Boolean  @default(false)
  resolvedNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([requirementId])
  // Audit DB-002 (2026-06-20): compliance-gap panels load by tenderId.
  @@index([tenderId])
}

model GeneratedDocument {
  id               String    @id @default(uuid())
  tenderId         String
  tender           Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  name             String
  documentType     String
  format           String    @default("DOCX")
  storagePath      String?
  exactFileName    String?
  exactOrder       Int?
  contentSummary   String?
  fileContent      String?
  // Persisted byte-integrity state. Legacy rows remain UNKNOWN and fail closed.
  contentSha256       String?
  contentByteLength   Int?
  contentMimeType     String?
  detectedFormat      String?
  integrityStatus     String    @default("UNKNOWN")
  integrityVerifiedAt DateTime?
  integrityFailureCode String?
  // File byte integrity — SHA-256 digest + byte size for final ZIP safety.
  // Populated by the generation/finalize pipeline. Final ZIP download
  // recomputes the digest from actual bytes and compares — prevents
  // corrupted or tampered files from entering the final package.
  sha256           String?
  byteSize         Int?
  validationStatus String    @default("PENDING")
  generationStatus String    @default("PLANNED")
  reviewStatus     String    @default("PENDING")
  reviewNotes      String?
  reviewedBy       String?
  reviewedAt       DateTime?
  // Counts of REVIEWED vs DRAFT sources used
  reviewedExpertCount Int?   @default(0)
  draftExpertCount    Int?   @default(0)
  reviewedProjectCount Int?  @default(0)
  draftProjectCount   Int?   @default(0)
  // Multi-reviewer audit trail (PR #247): per-document review actions
  // and threaded comments. The aggregate reviewStatus / reviewedBy /
  // reviewedAt fields above are kept for backwards compat (set to the
  // most-recent action), but the full history is in DocumentReview.
  reviews             DocumentReview[]
  comments            DocumentComment[]
  submissionPlanItems SubmissionPlanItem[]
  createdAt           DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Audit DB-002 (2026-06-20): every tender-detail panel loads docs by tenderId.
  // Was a sequential scan before this index.
  @@index([tenderId])
  // Partial unique index on (tenderId, exactFileName) for non-SUPERSEDED rows
  // is migration-managed because Prisma cannot express the WHERE clause.
  @@index([integrityStatus])
}

// Per-document review action audit trail (PR #247).
// Closes the spec's Module #16 gap: "approve, reject, mark ready for
// export, maintain approval history, internal comments". Up to PR #246
// the GeneratedDocument carried only a single reviewStatus +
// reviewedBy + reviewedAt — destructive update on each action with no
// history. This model preserves every approval action ever taken on
// the document for compliance / audit purposes.
//
// One row per action. Multiple reviewers can each approve/reject the
// same document; the aggregate reviewStatus on GeneratedDocument is
// updated to the most recent decision but every prior action remains.
model DocumentReview {
  id           String            @id @default(uuid())
  documentId   String
  document     GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User              @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  // APPROVED | REJECTED | CHANGES_REQUESTED | READY_FOR_EXPORT
  action       String
  notes        String?
  // Snapshot of the document's reviewStatus AT the time of this action,
  // so the audit trail shows the full state machine progression.
  priorStatus  String
  newStatus    String
  createdAt    DateTime          @default(now())

  @@index([documentId, createdAt])
  @@index([reviewerId])
}

// Threaded comment on a generated document (PR #247).
// Supports flat threads via parentId. UI renders top-level comments
// as cards with reply chains nested underneath. parentId NULL = root
// comment.
model DocumentComment {
  id           String            @id @default(uuid())
  documentId   String
  document     GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       DocumentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      DocumentComment[] @relation("CommentReplies")
  body         String
  // INTERNAL = visible to reviewers only; CLIENT_FACING never used in
  // current scope but reserved for future "share with client for
  // review" workflows.
  visibility   String            @default("INTERNAL")
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([documentId, createdAt])
  @@index([documentId, parentId])
  @@index([authorId])
}

model ExportPackage {
  id            String   @id @default(uuid())
  tenderId      String
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  status        String   @default("PREPARING")
  fileList      String   @default("[]")
  manifestJson  String?
  packageSha256 String?
  packageByteLength Int?
  integrityStatus String  @default("UNKNOWN")
  integrityVerifiedAt DateTime?
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Audit DB-002 (2026-06-20): export-package list loads by tenderId.
  @@index([tenderId])
  @@index([integrityStatus])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  description String
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  // Audit DB-003 (2026-06-20): AuditLog previously had ZERO indexes. The
  // guard_canonical_requirement_set_delete trigger runs a 4-column WHERE on
  // every TenderRequirement DELETE; without these indexes it was a full
  // table scan that grew linearly with audit history.
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  // Composite covering index for the trigger's exact WHERE clause
  @@index([entityType, entityId, action, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  entityType String?
  entityId   String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── ProposalVersion (G1 fix) ────────────────────────────────────────────────
// PR XX-A — adds the missing Prisma model for proposal version history.
// Bootstrap migration in lib/prisma.ts:508 already creates the table at
// runtime; this model exposes it through the typed Prisma client so the
// raw $queryRawUnsafe / $executeRawUnsafe calls in
// app/api/tenders/[id]/proposal-versions/* and lib/engine/generate-elite.ts
// can be replaced with type-safe access.
model ProposalVersion {
  id                  String   @id @default(uuid())
  tenderId            String
  tender              Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  version             Int
  markdown            String
  fileContent         String?
  benchmarkScore      Int?
  qualityScore        Int?
  winProbabilityScore Int?
  mode                String?
  summary             String?
  createdAt           DateTime @default(now())

  @@index([tenderId])
  @@index([tenderId, version])
  @@unique([tenderId, version]) // Prevents duplicate version numbers from concurrent /generate
}

// ─── MatchScoreBreakdown (G3 fix) ────────────────────────────────────────────
// PR XX-B — stores 12-perspective dimension scores for each TenderExpertMatch
// or TenderProjectMatch row. The original engine match path and the AI
// rematch path now write into the SAME table, so readiness, bid/no-bid,
// evaluator simulator, and proposal generator all consume identical
// scoring objects. dimensionCode follows the 12 perspectives:
// DISCIPLINE_FIT, SCOPE_COVERAGE, SENIORITY_OR_SCALE, SECTOR_FIT,
// ROLE_RECENCY, EVIDENCE_QUALITY, COMPLIANCE_CRITICALITY,
// PORTFOLIO_CONTRIBUTION, MANDATORY_ELIGIBILITY, DELIVERY_RISK,
// DIFFERENTIATION, COMMERCIAL_VALUE.
model MatchScoreBreakdown {
  id              String   @id @default(uuid())
  tenderId        String
  tender          Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  // entityType: "EXPERT" or "PROJECT"
  entityType      String
  // entityId points at Expert.id or Project.id (no FK constraint because
  // the entityType chooses the table — Prisma can't model that safely).
  entityId        String
  // dimensionCode: one of the 12 perspective codes above.
  dimensionCode   String
  // raw 0–100 score for this dimension.
  score           Float
  // weight assigned to this dimension when computing overall score.
  weight          Float    @default(1.0)
  // optional rationale (1–2 sentences) explaining the score.
  rationale       String?
  // source: "AI_REMATCH" | "ENGINE_MATCH" | "DETERMINISTIC_FALLBACK".
  source          String   @default("ENGINE_MATCH")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenderId, entityType, entityId, dimensionCode])
  @@index([tenderId, entityType])
  @@index([tenderId, entityId])
}

// ─── EvaluatorObjection (G4 fix) ─────────────────────────────────────────────
// PR XX-C — stores evaluator-simulator objections as structured rows so:
//   1. HIGH-severity unresolved objections become export blockers
//      (export-readiness checks this table).
//   2. Score trend can be tracked across versions.
//   3. The "rerun evaluator after fixes" workflow knows which objections
//      were closed and which are still open.
model EvaluatorObjection {
  id              String    @id @default(uuid())
  tenderId        String
  tender          Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  // version of the proposal this objection was raised against.
  proposalVersion Int       @default(1)
  // severity: "HIGH" | "MEDIUM" | "LOW"
  severity        String
  // category: "EVIDENCE_GAP" | "COMPLIANCE_GAP" | "EVAL_CRITERION_MISS" |
  // "FACT_ERROR" | "PRICING_GAP" | "OTHER"
  category        String
  title           String
  description     String
  // section the objection points at, e.g. "Section A.1", "Cover Letter".
  sectionRef      String?
  // recommended action to close the objection.
  recommendedAction String?
  // status: "OPEN" | "RESOLVED" | "WAIVED"
  status          String    @default("OPEN")
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNote  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenderId, status])
  @@index([tenderId, severity, status])
}

// ─── SectionEvidenceMap (G5 fix) ─────────────────────────────────────────────
// PR XX-D — section-level evidence map. Each generated proposal section is
// recorded with which requirements it covers, which evidence IDs it cites,
// the text hash (so we can detect when a section has been edited), and
// reviewer status. Powers:
//   • "weak section" detector  (low evidence count, no requirement coverage)
//   • "missing criterion depth" detector  (criterion has no section)
//   • Section regeneration that preserves evidence references.
model SectionEvidenceMap {
  id              String   @id @default(uuid())
  tenderId        String
  tender          Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  proposalVersion Int      @default(1)
  // canonical section ID, e.g. "cover-letter", "section-a-1", "section-c-2".
  sectionId       String
  sectionTitle    String
  // pipe-joined IDs to keep the schema portable across SQLite/Postgres.
  requirementIds  String   @default("")
  evidenceIds     String   @default("")
  expertIds       String   @default("")
  projectIds      String   @default("")
  textHash        String?
  wordCount       Int      @default(0)
  reviewerStatus  String   @default("PENDING")
  reviewerNote    String?
  // ─── Section Generation State (Phase 2 Upgrade) ───────────────────────────
  // PLANNED | GENERATING | GENERATED | FAILED | NEEDS_REVIEW | APPROVED | SUPERSEDED
  status          String   @default("PLANNED")
  content         String?
  aiProvider      String?
  lastGeneratedAt DateTime?
  generationAttemptId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenderId, proposalVersion, sectionId])
  @@index([tenderId])
}

// ─── AiJob / AiJobStep (G6 fix) ──────────────────────────────────────────────
// PR XX-E — background job queue. Long-running AI workflows (proposal
// generation, large rematch, evaluator simulation, deep Copilot analysis)
// can now be enqueued and resumed across requests, avoiding the 60s
// Vercel Hobby cap and 300s Pro cap. UI polls /api/ai-jobs/[id] for
// status and step-by-step logs.
model AiJob {
  id            String      @id @default(uuid())
  tenderId      String?
  tender        Tender?     @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  userId        String
  // jobType: "PROPOSAL_GENERATION" | "AI_REMATCH" | "EVALUATOR_SIM" |
  // "COPILOT_DEEP_ANALYSIS" | "PROFILE_FACT_EXTRACTION"
  jobType       String
  // status: "QUEUED" | "RUNNING" | "SUCCEEDED" | "PARTIAL_SUCCESS" | "FAILED" | "CANCELED"
  status        String      @default("QUEUED")
  // input (JSON-serialised) and output (JSON-serialised, may include refs).
  input         String      @default("{}")
  output        String?
  errorMessage  String?
  retries       Int         @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  // Versioning and non-destructive promotion fields
  runId               String?   @unique
  analysisInputHash   String?
  analysisVersion     BigInt    @default(autoincrement())
  stagedMergedResult  String?
  validationResult    String?
  promotedAt          DateTime?
  promotedBy          String?
  supersededBy        String?
  // Phase 5: Worker lease management for distributed claiming
  leaseOwner          String?   // Worker ID/pod name that owns current lease
  leaseExpiresAt      DateTime? // When lease expires (lease holder must heartbeat)
  nextAttemptAt       DateTime? // When to retry after failure/lease expiry
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  steps         AiJobStep[]
  analyzeChunks AiAnalyzeChunk[]
  retryState    AiAnalyzeRetryState?

  @@index([userId, status])
  @@index([tenderId, jobType])
  @@index([status, createdAt])
  @@index([leaseExpiresAt, status])
  @@index([nextAttemptAt, status])
}

// Durable retry state for the AI_ANALYZE background workflow. One row per
// AiJob (1:1). The provider-aware scheduler (lib/ai-analyze/retry-service.ts)
// reads this to decide when a stopped run may resume — bounded exponential
// backoff, only when a provider is actually eligible, never for non-retryable
// failures (corrupted extraction, ownership/auth, content-hash drift, weak
// grounding). Resumes from the SUCCEEDED AiAnalyzeChunk checkpoints, so a
// retry continues where it left off rather than restarting.
model AiAnalyzeRetryState {
  id                    String    @id @default(uuid())
  jobId                 String    @unique
  job                   AiJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenderId              String
  userId                String
  contentHash           String
  retryCount            Int       @default(0)
  nextRetryAt           DateTime?
  retryReason           String
  failureCategory       String
  nonRetryable          Boolean   @default(false)
  lastProviderAvailable Boolean   @default(false)
  lastCheckedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenderId, contentHash])
  @@index([nextRetryAt])
  @@index([nonRetryable, nextRetryAt])
}

model AiJobStep {
  id          String   @id @default(uuid())
  jobId       String
  job         AiJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stepIndex   Int
  stepName    String
  status      String   @default("PENDING")
  message     String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([jobId, stepIndex])
}

model AiAnalyzeChunk {
  failureCategory String?
  id           String   @id @default(uuid())
  tenderId     String
  userId       String
  contentHash  String
  chunkIndex   Int
  totalChunks  Int
  status       String   @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | SKIPPED
  provider     String?
  resultJson   String?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobId        String?
  job          AiJob?   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([tenderId, userId, contentHash, chunkIndex])
  @@index([tenderId, userId, contentHash])
  @@index([status])
  @@index([jobId])
}

// ─── ProviderHealthSnapshot ───────────────────────────────────────────────────
// Persists per-provider cooldown state across Vercel cold starts. The in-memory
// tracker in lib/ai-provider-health.ts resets on every cold start; this table
// lets the AI Analyze route restore active cooldowns on boot so a rate-limited
// provider isn't re-hit immediately after an instance recycles.
// Never stores API keys, prompts, or raw provider responses.
model ProviderHealthSnapshot {
  provider                  String    @id   // AiProviderName
  lastSuccessAt             DateTime?
  // Capability-specific success times so a cold start can restore whether a
  // provider last verified connectivity, analysis, or generation — not just a
  // generic success. Safe metadata only (timestamps, never keys/prompts).
  lastPingSucceededAt       DateTime?
  lastAnalysisSucceededAt   DateTime?
  lastGenerationSucceededAt DateTime?
  lastFailureAt             DateTime?
  lastFailureCategory       String?         // AiProviderFailureCategory
  lastSafeErrorMessage      String?         // already redacted by recordProviderFailure
  consecutiveFailures       Int       @default(0)
  cooldownUntil             DateTime?
  updatedAt                 DateTime  @updatedAt
}

// ─── PricingWorkbook + CostLine (G8 fix) ─────────────────────────────────────
// PR XX-F — structured pricing engine. Replaces ad-hoc commercial
// assumptions with a real pricing workbook the user can fill in,
// Copilot can reason against, and the export gate can validate.
model PricingWorkbook {
  id              String     @id @default(uuid())
  tenderId        String     @unique
  tender          Tender     @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  currency        String     @default("USD")
  // validity period in days
  validityDays    Int        @default(90)
  // VAT / withholding tax percent (0 if exempt)
  vatPercent      Float      @default(0)
  withholdingPct  Float      @default(0)
  // contingency percent applied to subtotal
  contingencyPct  Float      @default(0)
  // scenario the user has settled on: "AGGRESSIVE" | "BALANCED" | "CONSERVATIVE"
  scenario        String     @default("BALANCED")
  // explicit price-leakage check performed in technical envelope?
  noPriceLeakage  Boolean    @default(true)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lines           CostLine[]

  @@index([tenderId])
}

model CostLine {
  id              String          @id @default(uuid())
  workbookId      String
  workbook        PricingWorkbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  // category: "PERSONNEL" | "REIMBURSABLE" | "SUBCONSULTANT" | "EQUIPMENT" |
  //           "TRAVEL" | "OTHER"
  category        String
  // role label (for personnel) or description otherwise
  label           String
  // for personnel: days / months allocated; for non-personnel: quantity
  quantity        Float           @default(1)
  // unit: "DAY" | "MONTH" | "LUMP_SUM" | "EACH" | "KM"
  unit            String          @default("DAY")
  rate            Float           @default(0)
  // optional reference to the expert (for personnel rows) so we can
  // automatically pull the proposed expert's role and license from
  // the chosen team.
  expertId        String?
  // computed total = quantity * rate (kept on the row to avoid
  // re-computing in every UI render).
  total           Float           @default(0)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([workbookId])
}

// ─── TenderCopilotMessage ─────────────────────────────────────────────────────
// Persistent chat history for the per-tender AI Copilot workbench.
// Each row stores one turn (user question or assistant answer) so the
// conversation survives page reloads and can be reviewed in the UI.
// citations: JSON array of { page, quote, field } from the AI answer.
model TenderCopilotMessage {
  id        String   @id @default(cuid())
  tenderId  String
  userId    String
  role      String   // "user" | "assistant"
  content   String   @db.Text
  citations Json?    // array of { page, quote, field } from answer

  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenderId, userId, createdAt])
  @@index([tenderId, userId])
  @@index([createdAt])
}

// ─── TenderMetadataOverride ───────────────────────────────────────────────────
// Stores user-confirmed field states for tender metadata fields that are
// missing or require manual completion. Allows users to mark fields as
// NOT_APPLICABLE, USER_CONFIRMED, USER_EDITED, or IGNORED_WITH_REASON so
// the generation gate can proceed without hard-blocking on genuinely absent
// metadata that the user has reviewed.
model TenderMetadataOverride {
  id            String   @id @default(uuid())
  tenderId      String
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  field         String
  fieldState    String
  overrideValue String?
  reason        String?
  previousValue String?
  overriddenBy  String
  user          User     @relation(fields: [overriddenBy], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ─── Manual tender facts flexibility (authority model) ────────────────
  // The authority class of this override:
  //   SOURCE_GROUNDED | HUMAN_CONFIRMED_OPERATIONAL | NOT_STATED_IN_SOURCE
  //   | UNKNOWN | REJECTED_CANDIDATE
  // Computed by classifyTenderFactAuthority() at write time + re-computed
  // on read by the canonical resolver. Stored for query efficiency + audit.
  authorityClass   String?
  // The external source the user cited for a HUMAN_CONFIRMED_OPERATIONAL
  // value. Required for final export when the field is submission-critical.
  // One of CONFIRMATION_BASES in lib/engine/tender-fact-authority.ts.
  confirmationBasis String?
  // When the user confirmed the value (distinct from updatedAt because
  // the override row may be updated without re-confirming).
  confirmedAt      DateTime?

  @@unique([tenderId, field])
  @@index([tenderId])
}

// ─── PasswordResetToken ───────────────────────────────────────────────────────
// One-time password reset tokens. Stored hashed; consumed atomically.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  // Composite index added by migration 20260614170000 — used for
  // "list recent reset tokens for a user" admin queries.
  @@index([userId, createdAt])
}

// ─── RateLimitBucket ─────────────────────────────────────────────────────────
// Persistent rate-limiting buckets for multi-instance deployments.
model RateLimitBucket {
  keyHash   String   @id
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added by migration 20260614170000 — used by the cleanup job that
  // purges expired buckets before they accumulate.
  @@index([resetAt])
}

// Persisted, revisioned submission-plan authority created by migration
// 20260630000000_persisted_submission_plan_evidence. Unlike the BuildPlan
// compatibility projection, this model records immutable reviewed revisions.
model SubmissionPlanRevision {
  id                 String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenderId           String
  tender             Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  revision           Int
  status             String    @default("DRAFT")
  sourceContentHash  String
  requirementsHash   String
  createdById        String
  createdBy          User      @relation("SubmissionPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedById      String?
  confirmedBy        User?     @relation("SubmissionPlanConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  confirmedAt        DateTime? @db.Timestamptz(6)
  supersededAt       DateTime? @db.Timestamptz(6)
  invalidatedAt      DateTime? @db.Timestamptz(6)
  invalidationReason String?
  confirmationHash   String?
  items              SubmissionPlanItem[]

  @@unique([tenderId, revision])
  @@index([tenderId])
  @@index([status])
}

model SubmissionPlanItem {
  id                     String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  submissionPlanId       String
  submissionPlan         SubmissionPlanRevision @relation(fields: [submissionPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exactFileName          String
  exactOrder             Int
  documentType           String                 @default("TENDER_REQUIRED_FILE")
  format                 String                 @default("DOCX")
  envelope               String                 @default("TECHNICAL")
  status                 String                 @default("PLANNED")
  sourceRequirementIds   String                 @default("[]")
  sourceFileCitations    String                 @default("[]")
  requiresOriginalUpload Boolean                @default(false)
  generatedDocumentId    String?
  generatedDocument      GeneratedDocument?     @relation(fields: [generatedDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([submissionPlanId])
  @@index([generatedDocumentId])
}

model RequirementEvidenceDecision {
  id                   String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenderRequirementId  String
  tenderRequirement    TenderRequirement @relation(fields: [tenderRequirementId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenderFileId         String
  tenderFile           TenderFile        @relation(fields: [tenderFileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pageNumber           Int
  exactQuote           String
  evidenceType         String
  companyAssetType     String
  companyAssetId       String
  relevanceExplanation String
  reviewerId           String
  reviewer             User              @relation("RequirementEvidenceReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decisionStatus       String             @default("DRAFT")
  sourceContentHash    String
  companyEvidenceHash  String?
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  invalidatedAt        DateTime?          @db.Timestamptz(6)
  invalidationReason   String?

  @@index([tenderRequirementId])
  @@index([decisionStatus])
  @@index([companyAssetId])
}

// DB-005 FIX: This table was created by migration 20260613190000 but had no
// Prisma model, meaning prisma db push would drop it.
model SubmissionPlanState {
  tenderId             String    @id
  tender               Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  provenance           String    @default("NONE")
  confirmationStatus   String    @default("NOT_REQUIRED")
  derivedDocumentCount Int       @default(0)
  activeDocumentCount  Int       @default(0)
  confirmedAt          DateTime? @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
}

// Per-provider AI usage tracking for cost monitoring (OBS-004).
// Never stores API keys, prompts, or raw responses — only safe metadata.
model AiUsageRecord {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId          String
  tenderId        String?
  tender          Tender?  @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  jobId           String?
  provider        String
  useCase         String
  model           String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  latencyMs       Int      @default(0)
  success         Boolean  @default(false)
  failureCategory String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([tenderId, createdAt])
  @@index([provider, createdAt])
}

// Durable, auditable approval of a regex-fallback analysis, bound to the EXACT
// analysis job + content hash it was approved against (central readiness gate,
// condition I). A tender-wide ComplianceGap can never authorize fallback
// generation/export on its own; only a record here whose (tenderId, jobId,
// contentHash) match the CURRENT eligible job + recomputed content hash counts.
// The unique key means the approval automatically becomes invalid the moment a
// new job runs or the tender content changes (the hash moves), with no cleanup.
// Scalar-only (no Prisma relation fields) to mirror AiUsageRecord and avoid
// back-relation churn on Tender/AiJob/User.
model FallbackApprovalRecord {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenderId      String
  jobId         String
  contentHash   String
  approverId    String
  reason        String
  approvalRoute String   @default("manual")
  approvedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([tenderId, jobId, contentHash])
  @@index([tenderId, contentHash])
  @@index([jobId, contentHash])
}

// Durable, auditable human override permitting final generation/export on a WEAK
// (but not corrupted) extraction for a specific tender file (central readiness
// gate, condition B). One active override per (tenderId, tenderFileId). Corrupted
// extraction can never be overridden — only weak extraction. Scalar-only to
// mirror AiUsageRecord.
model ExtractionQualityOverride {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenderId       String
  tenderFileId   String
  qualityScore   Float
  overrideReason String
  overriddenBy   String
  overriddenAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([tenderId, tenderFileId])
  @@index([tenderId])
  @@index([tenderFileId])
}

// Persisted submission plan bound to tender content hash and file list.
// When the tender content changes (files added/removed/modified) or the file
// order changes, the contentHash will no longer match and the plan becomes
// invalid. Generation requires a plan whose contentHash matches the current
// tender state.
//
// Separate from GeneratedDocument rows, which track actual output files.
// PLANNED files in GeneratedDocument are virtual/readiness-only and never
// count as "part of the plan". Only a BuildPlan record binds the actual
// submission requirements to concrete document targets.
model BuildPlan {
  id                String   @id @default(uuid())
  tenderId          String   @unique
  tender            Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  // DRAFT | CONFIRMED | SUPERSEDED
  status            String   @default("DRAFT")
  revision          Int      @default(1)
  // Hash of tender file IDs + names (detects file additions, deletions, renames)
  contentHash       String
  // JSON array of file metadata at plan time: [{ fileId, fileName, order }]
  filesList         String   @default("[]")
  // JSON array of planned documents from buildSubmissionPlan()
  plannedDocuments  String   @default("[]")
  // JSON validation results
  validationJson    String?
  // Plan type: "EXPLICIT" (from exactFileNaming/exactFileOrder) or
  // "DERIVED" (from requirements) or "DERIVED_DRAFT" (fallback heuristic)
  planType          String   @default("DERIVED")
  // Items JSON (for #930 compatibility)
  itemsJson         String   @default("[]")
  // Audit trail — DRAFT/CONFIRMED service authoritative columns.
  builtById            String?
  createdBy            String?
  confirmedById        String?
  confirmedBy          String?
  confirmedRevision    Int?
  confirmedContentHash String?
  confirmedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([contentHash])
}

// ─── TenderFactsLedger ─────────────────────────────────────────────────────
// Universal tender facts ledger — replaces the fixed 26-field metadata
// checklist with a dynamic, extensible fact store. Each fact has:
// - a semantic key (e.g. "clientName", "deadline", "custom:sector_code");
// - a human display label;
// - a category (tender identity, submission, financial, etc.);
// - a value type (TEXT, DATE, EMAIL_LIST, MONEY, etc.);
// - an authority state (SOURCE_GROUNDED_CONFIRMED, HUMAN_CONFIRMED_OPERATIONAL, etc.);
// - source evidence (file, page, quote, content hash);
// - audit history (created by, confirmed by, timestamps);
// - review state.
//
// Legacy Tender scalar columns remain as backward-compatible projections
// derived from the effective facts. All new workflow consumers use
// resolveEffectiveTenderContext() which merges ledger facts + overrides.
model TenderFactsLedger {
  id                String   @id @default(uuid())
  tenderId          String
  tender            Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  // Semantic key — unique per tender. Built-in keys: "clientName", "title",
  // "deadline", "submissionMethod", etc. Custom keys: "custom:sector_code".
  semanticKey       String

  // Human display label (e.g. "Client Name", "Submission Deadline").
  displayLabel      String

  // Category — one of: tender-identity, procuring-entity, submission,
  // financial, eligibility, technical, personnel, experience, evaluation,
  // document-requirement, annex, contract, site-location, pre-bid,
  // procurement-process, legal-compliance, custom.
  category          String

  // Value type — one of: TEXT, LONG_TEXT, DATE, DATETIME, EMAIL_LIST, URL,
  // ADDRESS, MONEY, NUMBER, BOOLEAN, ENUM, LIST, JSON, DOCUMENT_RULE,
  // CONDITIONAL_NOTE.
  valueType         String

  // Normalized value — the canonical form (e.g. ISO date, uppercase enum).
  normalizedValue   String?

  // Raw source value — as extracted from the tender text.
  rawSourceValue    String?

  // Structured value JSON — for complex types (EMAIL_LIST, MONEY, JSON).
  structuredValueJson String?

  // Authority state — one of: SOURCE_GROUNDED_CONFIRMED,
  // SOURCE_GROUNDED_UNUSUAL_FORMAT, HUMAN_CONFIRMED_OPERATIONAL,
  // CANDIDATE_NEEDS_REVIEW, NOT_STATED_IN_SOURCE,
  // CONDITIONAL_OR_UNSCHEDULED, REJECTED_EXTRACTION.
  authorityState    String

  // Confidence — 0.0 to 1.0 (extraction confidence or 1.0 for human-confirmed).
  confidence        Float    @default(0)

  // Source status — "active" (evidence from active file) or "stale" (file deleted).
  sourceStatus      String   @default("active")

  // Relevance — "mandatory", "critical", "advisory", "informational".
  relevance         String   @default("informational")

  // Applicability — "applies", "not_applicable", "conditional".
  applicability     String   @default("applies")

  // Source evidence — file, page, quote, content hash.
  sourceFileId      String?
  sourcePage        Int?
  sourceQuote       String?
  sourceContentHash String?

  // Review state — "pending", "reviewed", "approved", "rejected".
  reviewState       String   @default("pending")

  // Manually entered — true when a human entered this fact.
  manuallyEntered   Boolean  @default(false)

  // Audit — reason and confirmation basis for human-confirmed facts.
  reason            String?
  confirmationBasis String?

  // Creation/update info.
  createdBy         String
  confirmedBy       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  confirmedAt       DateTime?

  // Superseded — when a newer fact replaces this one.
  supersededById    String?

  @@unique([tenderId, semanticKey])
  @@index([tenderId])
  @@index([tenderId, category])
  @@index([tenderId, authorityState])
}

// ─── TenderSubmissionEmail ─────────────────────────────────────────────────
// Per-email source provenance — replaces the pipe-joined submissionEmails
// string with structured per-email records. Each email has its own source
// file, page, and quote evidence.
model TenderSubmissionEmail {
  id            String   @id @default(uuid())
  tenderId      String
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  email         String
  sourceFileId  String?
  sourcePage    Int?
  sourceQuote   String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenderId, email])
  @@index([tenderId])
}

model TenderWorkflowRun {
  id             String   @id @default(cuid())
  companyId      String
  tenderId       String
  operation      String
  idempotencyKey String
  status         String
  phase          String?
  inputHash      String?
  outputHash     String?
  errorCode      String?
  errorMessage   String?
  warningsJson   Json?
  resultJson     Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([companyId, tenderId, operation, idempotencyKey], map: "TenderWorkflowRun_companyId_tenderId_operation_idempotencyKey_k")
  @@index([companyId, tenderId, operation, status])
  @@index([tenderId, createdAt])
}

// Blocker 5: Plan B staging data — synthetic JSON artifacts from Plan B
// import that must NEVER become an official CompanyDocument source.
// CompanyDocument is for official uploaded files only. Plan B staging
// data is diagnostic-only: it stores the parsed rawText, parsedExperts,
// parsedProjects, and suppliedSha256 for traceability without contaminating
// the official document authority.
model PlanBStaging {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originalFileName String
  sourceType       String?
  sourceCategory   String?
  normalizedCategory String?
  rawText          String?
  parsedExperts    Int?
  parsedProjects   Int?
  suppliedSha256   String?
  reviewNotes      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([companyId])
  @@index([originalFileName])
}
