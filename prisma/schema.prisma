generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String?
  email        String      @unique
  passwordHash String
  role         String      @default("PROPOSAL_MANAGER")
  company      Company?
  sessions     Session[]
  tenders      Tender[]
  auditLogs    AuditLog[]
  // PR #247 — DocumentReview / DocumentComment back-relations
  documentReviews  DocumentReview[]
  documentComments DocumentComment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id                String                    @id @default(uuid())
  name              String
  legalName         String?
  description       String?
  website           String?
  address           String?
  phone             String?
  email             String?
  country           String?
  serviceLines      String                    @default("[]")
  sectors           String                    @default("[]")
  profileSummary    String?
  knowledgeMode     String                    @default("PROFILE_FIRST")
  setupCompletedAt  DateTime?
  // Authorising representative (used in D.4 Declaration of Eligibility,
  // Cover Page Submitted-by/to block, and A.1 Company Background)
  gmName            String?
  gmTitle           String?
  gmLicense         String?
  // Institutional metadata (used in A.0 Portfolio at a Glance, A.1 Company
  // Background, A.7 In-House Capabilities)
  foundingYear      Int?
  headcount         Int?
  licenseGrade      String?
  registrationNumber String?
  tin               String?
  vat               String?
  userId            String                    @unique
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  experts           Expert[]
  projects          Project[]
  documents         CompanyDocument[]
  assets            CompanyAsset[]
  legalRecords      LegalRecord[]
  financialRecords  FinancialRecord[]
  complianceRecords CompanyComplianceRecord[]
  settings          AppSettings?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model AppSettings {
  id                     String   @id @default(uuid())
  companyId              String   @unique
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultCurrency        String   @default("USD")
  aiStrictMode           Boolean  @default(true)
  allowBrandingDefault   Boolean  @default(true)
  allowSignatureDefault  Boolean  @default(true)
  allowStampDefault      Boolean  @default(true)
  exportFormat           String   @default("DOCX")
  pageNumbering          Boolean  @default(true)
  includeTableOfContents Boolean  @default(false)
  language               String   @default("en")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model CompanyDocument {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  storagePath      String    @default("")
  fileContent      String?
  category         String    @default("OTHER")
  extractedText    String?
  // AI extraction state: PENDING | EXTRACTING | EXTRACTED | FAILED
  aiExtractionStatus String  @default("PENDING")
  aiExtractedAt    DateTime?
  aiExtractionError String?
  metadata         String    @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  expertsSourced  Expert[]
  projectsSourced Project[]

  @@index([companyId])
}

model CompanyAsset {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetType        String
  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  storagePath      String   @default("")
  fileContent      String?
  isActive         Boolean  @default(true)
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
}

// trustLevel values: REGEX_DRAFT | AI_DRAFT | REVIEWED
// Records start as REGEX_DRAFT (pattern-extracted) or AI_DRAFT (Claude-extracted).
// Only REVIEWED records are treated as authoritative in proposal generation.
model Expert {
  id               String           @id @default(uuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName         String
  title            String?
  email            String?
  phone            String?
  yearsExperience  Int?
  disciplines      String           @default("[]")
  sectors          String           @default("[]")
  certifications   String           @default("[]")
  profile          String?
  isActive         Boolean          @default(true)
  // Trust level — must be REVIEWED before use in final generation
  trustLevel       String           @default("REGEX_DRAFT")
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  // Source document that produced this record
  sourceDocumentId String?
  sourceDocument   CompanyDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenderMatches    TenderExpertMatch[]

  @@index([companyId])
  @@index([trustLevel])
  @@index([deletedAt])
}

// trustLevel values: REGEX_DRAFT | AI_DRAFT | REVIEWED
model Project {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  clientName    String?
  country       String?
  sector        String?
  serviceAreas  String           @default("[]")
  summary       String?
  contractValue Float?
  currency      String?
  startDate     DateTime?
  endDate       DateTime?
  // Trust level — must be REVIEWED before use in final generation
  trustLevel    String           @default("REGEX_DRAFT")
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  // Source document that produced this record
  sourceDocumentId String?
  sourceDocument   CompanyDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  evidences     ProjectEvidence[]
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenderMatches TenderProjectMatch[]

  @@index([companyId])
  @@index([trustLevel])
  @@index([deletedAt])
}

model ProjectEvidence {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  evidenceType     String
  description      String?
  fileName         String?
  storagePath      String?
  extractedText    String?
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LegalRecord {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recordType      String
  title           String
  authority       String?
  referenceNumber String?
  issueDate       DateTime?
  expiryDate      DateTime?
  status          String    @default("ACTIVE")
  metadata        String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FinancialRecord {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear Int
  recordType String
  currency   String?  @default("USD")
  amount     Float?
  notes      String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CompanyComplianceRecord {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  complianceType  String
  title           String
  status          String    @default("ACTIVE")
  evidenceSummary String?
  referenceNumber String?
  expiryDate      DateTime?
  metadata        String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Tender {
  id                    String               @id @default(uuid())
  title                 String
  description           String?
  reference             String?
  clientName            String?
  category              String               @default("General")
  country               String?
  budget                Float?
  currency              String               @default("USD")
  deadline              DateTime?
  submissionMethod      String?
  submissionAddress     String?
  status                String               @default("DRAFT")
  stage                 String               @default("TENDER_INTAKE")
  intakeSummary         String?
  analysisSummary       String?
  evaluationMethodology String?
  pageLimit             Int?
  exactFileOrder        String               @default("[]")
  exactFileNaming       String               @default("[]")
  readinessScore        Float                @default(0)
  notes                 String?
  bidOutcome            String?
  bidOutcomeNote        String?
  bidOutcomeAt          DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  files                 TenderFile[]
  requirements          TenderRequirement[]
  expertMatches         TenderExpertMatch[]
  projectMatches        TenderProjectMatch[]
  complianceGaps        ComplianceGap[]
  complianceMatrix      ComplianceMatrix[]
  generatedDocuments    GeneratedDocument[]
  exportPackages        ExportPackage[]
}

model TenderFile {
  id               String   @id @default(uuid())
  tenderId         String
  tender           Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  storagePath      String   @default("")
  fileContent      String?
  classification   String?
  extractedText    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TenderRequirement {
  id                   String             @id @default(uuid())
  tenderId             String
  tender               Tender             @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  code                 String?
  title                String
  description          String
  requirementType      String
  priority             String
  sectionReference     String?
  requiredQuantity     Int?
  pageLimit            Int?
  exactFileName        String?
  exactOrder           Int?
  restrictions         String?
  isResolved           Boolean            @default(false)
  complianceMatrixRows ComplianceMatrix[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model ComplianceMatrix {
  id                String             @id @default(uuid())
  tenderId          String
  tender            Tender             @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  requirementId     String?
  requirement       TenderRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  evidenceType      String
  evidenceSource    String
  evidenceReference String?
  supportLevel      String             @default("PARTIAL")
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model TenderExpertMatch {
  id         String   @id @default(uuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  expertId   String
  expert     Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  score      Float
  rationale  String?
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenderId, expertId])
  @@index([tenderId])
}

model TenderProjectMatch {
  id         String   @id @default(uuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  score      Float
  rationale  String?
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenderId, projectId])
  @@index([tenderId])
}

model ComplianceGap {
  id             String   @id @default(uuid())
  tenderId       String
  tender         Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  requirementId  String?
  severity       String
  title          String
  description    String
  mitigationPlan String?
  isResolved     Boolean  @default(false)
  resolvedNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GeneratedDocument {
  id               String    @id @default(uuid())
  tenderId         String
  tender           Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  name             String
  documentType     String
  format           String    @default("DOCX")
  storagePath      String?
  exactFileName    String?
  exactOrder       Int?
  contentSummary   String?
  fileContent      String?
  validationStatus String    @default("PENDING")
  generationStatus String    @default("PLANNED")
  reviewStatus     String    @default("PENDING")
  reviewNotes      String?
  reviewedBy       String?
  reviewedAt       DateTime?
  // Counts of REVIEWED vs DRAFT sources used
  reviewedExpertCount Int?   @default(0)
  draftExpertCount    Int?   @default(0)
  reviewedProjectCount Int?  @default(0)
  draftProjectCount   Int?   @default(0)
  // Multi-reviewer audit trail (PR #247): per-document review actions
  // and threaded comments. The aggregate reviewStatus / reviewedBy /
  // reviewedAt fields above are kept for backwards compat (set to the
  // most-recent action), but the full history is in DocumentReview.
  reviews          DocumentReview[]
  comments         DocumentComment[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Per-document review action audit trail (PR #247).
// Closes the spec's Module #16 gap: "approve, reject, mark ready for
// export, maintain approval history, internal comments". Up to PR #246
// the GeneratedDocument carried only a single reviewStatus +
// reviewedBy + reviewedAt — destructive update on each action with no
// history. This model preserves every approval action ever taken on
// the document for compliance / audit purposes.
//
// One row per action. Multiple reviewers can each approve/reject the
// same document; the aggregate reviewStatus on GeneratedDocument is
// updated to the most recent decision but every prior action remains.
model DocumentReview {
  id           String            @id @default(uuid())
  documentId   String
  document     GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User              @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  // APPROVED | REJECTED | CHANGES_REQUESTED | READY_FOR_EXPORT
  action       String
  notes        String?
  // Snapshot of the document's reviewStatus AT the time of this action,
  // so the audit trail shows the full state machine progression.
  priorStatus  String
  newStatus    String
  createdAt    DateTime          @default(now())

  @@index([documentId, createdAt])
  @@index([reviewerId])
}

// Threaded comment on a generated document (PR #247).
// Supports flat threads via parentId. UI renders top-level comments
// as cards with reply chains nested underneath. parentId NULL = root
// comment.
model DocumentComment {
  id           String            @id @default(uuid())
  documentId   String
  document     GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       DocumentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      DocumentComment[] @relation("CommentReplies")
  body         String
  // INTERNAL = visible to reviewers only; CLIENT_FACING never used in
  // current scope but reserved for future "share with client for
  // review" workflows.
  visibility   String            @default("INTERNAL")
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([documentId, createdAt])
  @@index([authorId])
}

model ExportPackage {
  id            String   @id @default(uuid())
  tenderId      String
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  status        String   @default("PREPARING")
  fileList      String   @default("[]")
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  description String
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
}
