{
  "name": "hope-tender-path-b",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-env.mjs && prisma generate && next build",
    "vercel-build": "node scripts/check-env.mjs && prisma generate && node scripts/migrate-deploy-safe.mjs && next build",
    "audit:release-integrity": "node scripts/audit-release-integrity.mjs",
    "db:check-critical-schema": "node scripts/check-critical-schema.mjs",
    "release:verify": "npm run audit:release-integrity && npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/run-tests.mjs",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 50",
    "postinstall": "prisma generate",
    "reconcile:ai": "node scripts/reconcile-gap-closure.mjs",
    "start": "next start",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo-seed": "tsx prisma/demo-seed.ts",
    "db:push": "prisma db push --accept-data-loss=false",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:safe": "node scripts/migrate-deploy-safe.mjs",
    "electron": "electron electron/main.js",
    "electron:local": "cross-env HOPE_TENDER_DESKTOP_MODE=local-server electron electron/main.js",
    "build:desktop": "electron-builder --config electron/electron-builder.json --win --mac --linux",
    "build:desktop:win": "electron-builder --config electron/electron-builder.json --win",
    "build:desktop:mac": "electron-builder --config electron/electron-builder.json --mac",
    "build:desktop:linux": "electron-builder --config electron/electron-builder.json --linux",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "main": "electron/main.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "@swc/helpers": "^0.5.23",
    "@types/nodemailer": "^8.0.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "15.5.19",
    "next-intl": "^4.13.0",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^3.2.0",
    "pdfjs-dist": "^5.4.394",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.18",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.0.0",
    "typescript": "6.0.3"
  }
}
