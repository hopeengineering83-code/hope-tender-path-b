{
  "name": "hope-tender-path-b",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "prisma migrate deploy && next dev",
    "build": "node scripts/check-env.mjs && prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "audit:release-integrity": "node scripts/audit-release-integrity.mjs && node scripts/audit-safe-api-errors.mjs && node scripts/audit-no-user-facing-metadata.mjs && node scripts/reconcile-gap-closure.mjs",
    "db:check-critical-schema": "node scripts/check-critical-schema.mjs",
    "db:verify-retroactive-init": "node scripts/verify-retroactive-init.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "release:verify": "npm run audit:release-integrity && npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/run-tests.mjs",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 50",
    "postinstall": "prisma generate",
    "reconcile:ai": "node scripts/reconcile-gap-closure.mjs",
    "start": "next start",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo-seed": "tsx prisma/demo-seed.ts",
    "db:push": "prisma db push --accept-data-loss=false",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:safe": "node scripts/migrate-deploy-safe.mjs",
    "electron": "electron electron/main.js",
    "electron:local": "cross-env HOPE_TENDER_DESKTOP_MODE=local-server electron electron/main.js",
    "build:desktop": "electron-builder --config electron/electron-builder.json --win --mac --linux",
    "build:desktop:win": "electron-builder --config electron/electron-builder.json --win",
    "build:desktop:mac": "electron-builder --config electron/electron-builder.json --mac",
    "build:desktop:linux": "electron-builder --config electron/electron-builder.json --linux",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "audit:no-user-facing-metadata": "node scripts/audit-no-user-facing-metadata.mjs",
    "audit:safe-api-errors": "node scripts/audit-safe-api-errors.mjs",
    "audit:workflow-state-consistency": "node scripts/audit-workflow-state-consistency.mjs"
  },
  "main": "electron/main.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@e965/xlsx": "^0.20.3",
    "@google/generative-ai": "^0.24.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@swc/helpers": "^0.5.23",
    "@types/nodemailer": "^8.0.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^2.4.3",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "15.5.22",
    "next-intl": "^4.13.0",
    "nodemailer": "9.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^3.2.0",
    "pdfjs-dist": "5.4.296",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "undici": "^8.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "happy-dom": "^20.10.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "rimraf": "^5.0.5",
    "glob": "^13.0.6",
    "sharp": "0.35.3",
    "nanoid": "^5.1.16",
    "js-yaml": ">=4.3.1",
    "deepmerge-ts": "^8.0.1",
    "@xmldom/xmldom": "^0.8.15"
  }
}
